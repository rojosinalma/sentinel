#!/usr/bin/env ruby
# frozen_string_literal: true

# sentinel CLI:
#   bin/sentinel serve            run the app (puma) with the loop
#   bin/sentinel once             one cycle, print the /status JSON, exit (parity with bash --once)
#   bin/sentinel status           alias of once
#   bin/sentinel hold [on|off]    block/release automatic failback; no argument prints the state
#   bin/sentinel promote [...]    run the service's promote hook under a majority lease
#                                 (--dry-run skips the lease; flags pass through: --force --fast)
#   bin/sentinel demote [...]     run the demote hook under a majority lease (asks for the word
#                                 "demote" unless --yes; --dry-run skips the lease)
#
# --service <name> (default opencode) picks the service for status/promote/demote.

require "dotenv"
Dotenv.load(File.expand_path("../.env", __dir__))
require_relative "../lib/log"
require_relative "../lib/sentinel"

def service_option
  i = ARGV.index("--service") or return Sentinel::Status::LEGACY_SERVICE
  ARGV.delete_at(i)
  ARGV.delete_at(i) or abort "--service needs a name"
end

def run_transition(cmd)
  abort "NODE_NAME is not set (see .env.example)" unless Sentinel.enabled?
  rt = Sentinel.boot!
  cluster = rt[:cluster]
  name = service_option
  service = cluster.services[name] or abort "unknown service #{name.inspect} (have #{cluster.services.keys.join(', ')})"
  unless cluster.node_name == service.standby
    abort "this node (#{cluster.node_name}) is not the standby of #{service.name} " \
          "(#{service.standby}); run it there"
  end
  hook = File.join(File.expand_path("../hooks", __dir__), service.name, cmd)
  abort "hook #{hook} missing or not executable" unless File.executable?(hook)
  env = Sentinel.hook_env(cluster, rt[:state]).merge("PRIMARY" => service.primary, "STANDBY" => service.standby)

  exec(env, hook, *ARGV) if ARGV.include?("--dry-run")

  begin
    grant = rt[:lease].acquire!(service: service.name, action: cmd)
  rescue Sentinel::Lease::Denied => e
    abort "majority lease denied: #{e.reasons.join('; ')}"
  end
  stop_queue = Queue.new
  renewer = Thread.new do
    g = grant
    loop do
      break if stop_queue.pop(timeout: Sentinel::Config.fetch(:LEASE_RENEW_S)) == :stop

      begin
        g = rt[:lease].renew!(g)
      rescue Sentinel::Lease::Expired => e
        $log.error "[cli] #{e.message}"
        break
      end
    end
  end

  system(env, hook, *ARGV)
  rc = $?.exitstatus || 1 # rubocop:disable Style/SpecialGlobalVars
  stop_queue << :stop
  renewer.join(1)
  rt[:lease].release!(grant)

  mode_after = rt[:state].mode(default: service.primary)
  rt[:store].set("primary.#{service.name}", mode_after)
  rt[:store].set("primary_at.#{service.name}", Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ"))
  exit rc
end

cmd = ARGV.shift || "status"

case cmd
when "serve"
  port = Sentinel::Config.fetch(:SENTINEL_PORT)
  exec("bundle", "exec", "puma", "-b", "tcp://0.0.0.0:#{port}",
       File.expand_path("../config.ru", __dir__))
when "once", "status"
  abort "NODE_NAME is not set (see .env.example)" unless Sentinel.enabled?
  name = service_option
  rt = Sentinel.boot!
  rt[:loop].cycle!
  puts Sentinel::Status.to_json(
    Sentinel::Status.build(loop: rt[:loop], state: rt[:state], config: rt[:config], service: name)
  )
when "promote", "demote"
  run_transition(cmd)
when "hold"
  state = Sentinel::State.new(Sentinel::Config.fetch(:STATE_DIR))
  case ARGV.shift
  when "on"
    state.hold_on!(ENV.fetch("USER", "?"))
    puts "hold on"
  when "off"
    state.hold_off!
    puts "hold off"
  when nil, "status"
    puts state.hold? ? "on" : "off"
  else
    abort "usage: sentinel hold [on|off|status]"
  end
else
  abort "usage: sentinel serve | once | status | promote | demote | hold [on|off|status]"
end
