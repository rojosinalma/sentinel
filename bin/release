#!/usr/bin/env bash
# Cut a release: write VERSION, commit, tag vX.Y.Z and push. The publish-image workflow builds the
# multi-arch image for the tag and pushes ghcr.io/rojosinalma/sentinel:X.Y.Z, :X.Y and :sha-<short>.
#
#   bin/release <version>      e.g. bin/release 0.6.0
#   RELEASE_GH=1               also create a GitHub release from the CHANGELOG section (needs gh)
#   RELEASE_NO_PUSH=1          commit and tag only
set -euo pipefail
cd "$(dirname "$0")/.."

version="${1:?usage: bin/release <version>}"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "version must be X.Y.Z" >&2; exit 1; }
[[ -z "$(git status --porcelain)" ]] || { echo "working tree not clean" >&2; exit 1; }
git rev-parse -q --verify "refs/tags/v$version" >/dev/null && { echo "tag v$version exists" >&2; exit 1; }
grep -q "^## \[$version\]" CHANGELOG.md || { echo "CHANGELOG.md has no [$version] section" >&2; exit 1; }

printf '%s\n' "$version" > VERSION
sed -i -E "s/(SENTINEL_TAG:-)[0-9.]+/\1$version/" compose.yaml witness/compose.yaml examples/acting-node/compose.yaml
sed -i -E "s/^SENTINEL_TAG=.*/SENTINEL_TAG=$version/" .env.example
git add VERSION compose.yaml witness/compose.yaml examples/acting-node/compose.yaml .env.example
git commit -q -m "Release $version"
git tag -a "v$version" -m "sentinel $version"
echo "tagged v$version"

[[ "${RELEASE_NO_PUSH:-0}" == 1 ]] && exit 0
git push origin HEAD "v$version"

if [[ "${RELEASE_GH:-0}" == 1 ]]; then
  notes="$(awk -v v="$version" '$0 ~ "^## \\["v"\\]" {p=1; next} /^## \[/ {p=0} p' CHANGELOG.md)"
  gh release create "v$version" --title "sentinel $version" --notes "$notes"
fi
