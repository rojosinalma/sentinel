#!/usr/bin/env bash
# Build the image and distribute it: amd64 to silver's registry (+ pre-pull on tiny), multi-arch
# (amd64 + arm64 for the witness-1 witness) to GHCR via buildx. Never prints the GHCR token.
#
#   bin/release [tag]        default tag: VERSION file; `sha` uses the git short sha
#   RELEASE_NO_TINY=1        skip the tiny pre-pull
#   RELEASE_NO_GHCR=1        skip the multi-arch GHCR push (local + silver registry only)
#
# Tunables (env, with defaults): REGISTRY, REGISTRY_MIRROR, GHCR_REPO, GHCR_USER, SERVER_ENV, TINY_SSH.
set -euo pipefail
cd "$(dirname "$0")/.."

REGISTRY="${REGISTRY:-registry.example.internal}"
GHCR_REPO="${GHCR_REPO:-ghcr.io/rojosinalma/homelab/sentinel}"
GHCR_USER="${GHCR_USER:-rojosinalma}"
SERVER_ENV="${SERVER_ENV:-$HOME/.config/opencode/server.env}"
TINY_SSH="${TINY_SSH:-tiny}"
NAME=sentinel

tag="${1:-$(tr -d '[:space:]' < VERSION)}"
[[ "$tag" == sha ]] && tag="$(git rev-parse --short HEAD)"
built="$(date -u +%Y-%m-%dT%H:%MZ)"
local_ref="$NAME:$tag"

log() { printf '[release] %s\n' "$*"; }
fail() { printf '[release] ERROR: %s\n' "$*" >&2; exit 1; }

log "building $local_ref (built $built)"
docker build -q --build-arg APP_VERSION="$tag" --build-arg BUILD_TIME="$built" \
  --label "org.opencontainers.image.source=https://github.com/rojosinalma/homelab" -t "$local_ref" . >/dev/null

docker tag "$local_ref" "$REGISTRY/$NAME:$tag"
log "pushing $REGISTRY/$NAME:$tag"
docker push -q "$REGISTRY/$NAME:$tag" >/dev/null

if [[ "${RELEASE_NO_GHCR:-0}" != 1 ]]; then
  [[ -r "$SERVER_ENV" ]] || fail "cannot read $SERVER_ENV for GHCR_TOKEN"
  grep -q '^GHCR_TOKEN=' "$SERVER_ENV" || fail "no GHCR_TOKEN in $SERVER_ENV"
  sed -n 's/^GHCR_TOKEN=//p' "$SERVER_ENV" | head -n1 | tr -d "\"'" \
    | docker login ghcr.io -u "$GHCR_USER" --password-stdin >/dev/null 2>&1 || fail "docker login ghcr.io failed"
  log "pushing $GHCR_REPO:$tag (multi-arch amd64+arm64 via buildx)"
  docker buildx build --platform linux/amd64,linux/arm64 \
    --build-arg APP_VERSION="$tag" --build-arg BUILD_TIME="$built" \
    --label "org.opencontainers.image.source=https://github.com/rojosinalma/homelab" \
    -t "$GHCR_REPO:$tag" --push . >/dev/null 2>&1 || fail "buildx multi-arch push failed"
fi

if [[ "${RELEASE_NO_TINY:-0}" != 1 ]]; then
  log "pre-pulling $REGISTRY/$NAME:$tag on tiny"
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$TINY_SSH" "docker pull -q $REGISTRY/$NAME:$tag" >/dev/null \
    || fail "pre-pull on tiny failed"
fi

log "done: $REGISTRY/$NAME:$tag  $GHCR_REPO:$tag"
echo "$tag"
