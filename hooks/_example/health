#!/usr/bin/env bash
# Example health hook (docs/hooks.md): runs every HOST_HEALTH_INTERVAL_S while promoted. A real
# one probes the primary host deeper than the sentinel can (ssh login, units, containers). The
# loop reads the LAST line of stdout: `up` or `down <reason>`.
set -euo pipefail
echo "$(date -u +%FT%TZ) [example-health] args=$* SERVICE=${SERVICE:-} PRIMARY=${PRIMARY:-} ACTING_NODE=${ACTING_NODE:-}"
echo "up"
exit 0
