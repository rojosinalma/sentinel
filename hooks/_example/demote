#!/usr/bin/env bash
# Example demote hook (docs/hooks.md). A real demote stops the standby's copy of the service,
# carries the data back to the primary and starts it there, then writes PRIMARY to $STATE_DIR/mode.
# This one only does the hold check every demote owes and moves the mode file back.
# Called as: demote --yes --auto [--dry-run]. Exit 0 done, 1 refused/nothing changed, 2 degraded.
set -euo pipefail
echo "$(date -u +%FT%TZ) [example-demote] args=$* SERVICE=${SERVICE:-} PRIMARY=${PRIMARY:-} STANDBY=${STANDBY:-} DRY_RUN=${DRY_RUN:-}"
[[ "${DRY_RUN:-false}" == true ]] && exit 0
: "${STATE_DIR:?STATE_DIR unset}"
if [[ -e "$STATE_DIR/hold" || -e "${NODE_STATE_DIR:-$STATE_DIR}/hold" ]]; then
  echo "hold active, refusing"
  exit 1
fi
printf '%s\n' "${PRIMARY:?PRIMARY unset}" > "$STATE_DIR/mode"
printf '%s %s\n' "$(date -u +%FT%TZ)" "$PRIMARY" >> "$STATE_DIR/mode.history"
echo "mode=$PRIMARY written"
exit 0
