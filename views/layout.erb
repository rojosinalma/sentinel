<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>standby status · <%= @host %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/dracula.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
  <script>
    (function() {
      var t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body>
  <nav class="navbar navbar-padded sticky-top">
    <div class="d-flex align-items-center w-100 gap-3">
      <a class="brand d-flex align-items-center gap-2" href="/"><i class="bi bi-shield-shaded"></i> standby status</a>
      <span class="badge badge-tint tint-cyan" title="Which instance of this page answered"><i class="bi bi-hdd-network"></i> served by <%= @host %></span>
      <span id="stale" class="badge badge-tint tint-orange d-none" title="Last refresh failed; showing the previous result"><i class="bi bi-wifi-off"></i> stale</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span class="nav-meta" id="generated" title="When the data was collected">—</span>
        <button class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode"><i class="bi bi-sun-fill theme-icon-light"></i><i class="bi bi-moon-fill theme-icon-dark"></i></button>
      </div>
    </div>
  </nav>

  <main class="main-content">
    <%== yield %>
  </main>

  <div id="toast-container"></div>

  <footer class="app-footer">
    <div class="footer-left">
      <% if @other_url && !@other_url.empty? %>
        <a class="footer-link" href="<%= @other_url %>" title="Open the instance running on the other host"><i class="bi bi-arrow-left-right"></i> <%= @other_name.empty? ? "other instance" : "#{@other_name} instance" %></a>
      <% end %>
    </div>
    <div class="footer-right">
      <span class="footer-version">standby-status <%= @version %><% unless @built_at.empty? %> · built <%= @built_at %><% end %> · <%= @host %></span>
    </div>
  </footer>

  <script>
    window.STANDBY = { refreshS: <%= @refresh_s.to_i %>, host: <%== @host.to_json %> };
    function toggleTheme() {
      const t = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t); localStorage.setItem('theme', t);
    }
  </script>
  <script src="/js/app.js"></script>
</body>
</html>
