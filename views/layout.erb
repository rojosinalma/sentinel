<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>sentinel · <%= @host %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <%# tailor head (vendored public/tailor/tailor-head.html, kept current by `tailor sync`) %>
  <%== File.read(File.join(Dir.pwd, "public/tailor/tailor-head.html")) %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body>
<div class="t-shell" data-sidebar="none">
  <header class="t-navbar t-shell-nav">
    <a class="t-navbar-brand" href="/"><i class="t-icon bi bi-shield-shaded" aria-hidden="true"></i>sentinel</a>
    <span class="t-badge" data-tone="info" data-variant="tint" title="Which instance of this page answered"><i class="bi bi-hdd-network"></i> served by <%= @host %></span>
    <span id="stale" class="t-badge d-none" data-tone="warning" data-variant="solid" title="Last refresh failed; showing the previous result"><i class="bi bi-wifi-off"></i> stale</span>
    <div class="t-navbar-end">
      <select class="t-select" data-size="sm" data-tailor-picker="skin" aria-label="Skin" title="Skin">
        <% %w[webtui bootstrap daisyui govuk luz pico simple tufte].each do |s| %><option value="<%= s %>"><%= s %></option><% end %>
      </select>
      <select class="t-select" data-size="sm" data-tailor-picker="palette" aria-label="Palette" title="Palette">
        <% %w[dracula ayu catppuccin everforest flexoki gruvbox kanagawa modusvivendi nightfox nightowl nord onedark oxocarbon poimandres rosepine selenized solarized synthwave84 tokyonight vitesse zenburn].each do |p| %><option value="<%= p %>"><%= p %></option><% end %>
      </select>
      <span class="nav-meta" id="generated" title="When the data was collected">—</span>
      <button class="t-btn" data-variant="ghost" data-size="sm" data-tailor-mode-toggle type="button" aria-label="Toggle light/dark" title="Toggle light/dark mode"><i class="bi bi-sun-fill theme-icon-light"></i><i class="bi bi-moon-fill theme-icon-dark"></i></button>
    </div>
  </header>

  <main class="t-shell-main t-page">
    <%== yield %>
  </main>

  <footer class="t-footer t-shell-foot">
    <% if @other_url && !@other_url.empty? %>
      <a class="footer-link" href="<%= @other_url %>" title="Open the instance running on the other host"><i class="bi bi-arrow-left-right"></i> <%= @other_name.empty? ? "other instance" : "#{@other_name} instance" %></a>
    <% end %>
    <div class="t-footer-end">
      <span class="t-footer-version">sentinel <%= @version %><% unless @built_at.empty? %> · built <%= @built_at %><% end %> · <%= @host %></span>
    </div>
  </footer>
</div>

<%# app.js appends .toast-item here; the region is tailor's toast stack %>
<div id="toast-container" class="t-toasts" aria-live="polite" aria-atomic="false"></div>

<script>
  window.STANDBY = { refreshS: <%= @refresh_s.to_i %>, host: <%== @host.to_json %> };
  // Transitional shim: app.js still drives its two dialogs through the Bootstrap Modal API
  // (getOrCreateInstance().show()/hide(), data-bs-dismiss, the hidden.bs.modal event). The dialogs
  // are native <dialog class="t-dialog"> now, so map that API onto showModal()/close() until
  // app.js is ported to Tailor.confirm / Tailor.dialogs.
  window.bootstrap = { Modal: { getOrCreateInstance: function (el) {
    if (!el._shim) {
      el._shim = {
        show: function () {
          el.querySelectorAll('.modal-title').forEach(function (h) { h.classList.add('t-dialog-title'); });
          el.querySelectorAll('.btn:not(.t-btn)').forEach(function (b) {
            b.classList.add('t-btn');
            b.dataset.variant = b.classList.contains('btn-danger') ? 'danger' : b.classList.contains('btn-primary') ? 'primary' : 'secondary';
          });
          if (!el.open) el.showModal();
        },
        hide: function () { if (el.open) el.close(); }
      };
      el.addEventListener('close', function () { el.dispatchEvent(new Event('hidden.bs.modal')); });
      el.querySelectorAll('[data-bs-dismiss="modal"]').forEach(function (b) { b.addEventListener('click', function () { el._shim.hide(); }); });
    }
    return el._shim;
  } } };
</script>
<script src="/js/app.js"></script>
</body>
</html>
