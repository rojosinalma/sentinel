<header class="t-page-header">
  <h1 class="t-page-title">sentinel · <span id="node-name"><%= @host %></span></h1>
  <span id="flag-quorum" class="t-badge" data-variant="tint" data-tone="neutral" data-size="lg" title="Majority agreement across the cluster nodes"><i class="bi bi-diagram-3" aria-hidden="true"></i> quorum <span id="quorum-value">…</span></span>
  <span id="flag-peers" class="t-badge" data-variant="tint" data-tone="neutral" title="Peer sentinels this node heard from in the last cycle"><i class="bi bi-broadcast" aria-hidden="true"></i> peers <span id="peers-value">—</span></span>
  <span id="flag-hold" class="t-badge" data-variant="tint" data-tone="yellow" hidden title="state/hold is present on this node: automatic failback is paused"><i class="bi bi-pause-circle" aria-hidden="true"></i> hold</span>
  <span id="flag-transition" class="t-badge" data-variant="solid" data-tone="warning" hidden></span>
  <span id="flag-routes" class="t-badge" data-variant="tint" data-tone="info" hidden title="Where the public HA hostnames point"></span>
  <div class="t-page-actions">
    <span class="nav-meta t-nowrap" id="cluster-meta" title="Last cycle of this node's loop"></span>
    <span class="nav-meta t-nowrap">v<%= @version %></span>
  </div>
</header>

<div class="t-stack" data-gap="4">
  <div class="t-grid" data-min="md" id="services-row">
    <!-- one card per service, cloned from #service-card-tpl -->
  </div>

  <div class="t-grid" data-min="md">
    <section class="t-card">
      <div class="t-card-header"><h2 class="t-card-title"><i class="t-icon bi bi-hdd-rack" aria-hidden="true"></i>Hosts</h2><span class="t-card-tools nav-meta t-nowrap" id="hosts-meta"></span></div>
      <div class="t-card-body">
        <table class="t-table hosts-table" data-density="compact">
          <thead><tr><th class="t-nowrap">host</th><th class="t-nowrap">role</th><th class="t-nowrap">probes</th><th class="t-nowrap">peer</th></tr></thead>
          <tbody id="hosts-body"></tbody>
        </table>
        <div class="t-stat-sub mt-2" id="hosts-empty" hidden>no cycle yet</div>
      </div>
    </section>

    <section class="t-card">
      <div class="t-card-header"><h2 class="t-card-title"><i class="t-icon bi bi-clock-history" aria-hidden="true"></i>Transitions</h2></div>
      <div class="t-card-body">
        <dl class="t-facts facts-grid" id="transitions"></dl>
        <div class="t-stat-sub" id="transitions-empty">no promote/demote recorded yet</div>
      </div>
    </section>

    <section class="t-card">
      <div class="t-card-header"><h2 class="t-card-title"><i class="t-icon bi bi-list-ul" aria-hidden="true"></i>Events</h2><span class="t-card-tools nav-meta t-nowrap" id="events-meta"></span></div>
      <div class="t-card-body">
        <table class="t-table hosts-table events-table" data-density="compact">
          <tbody id="events"></tbody>
        </table>
        <div class="t-stat-sub" id="events-empty" hidden>no events yet</div>
      </div>
    </section>
  </div>
</div>

<div class="t-empty" id="disabled-state" hidden>
  <i class="t-icon t-empty-icon bi bi-shield-slash" aria-hidden="true"></i>
  <h3 class="t-empty-title">No sentinel on this instance</h3>
  <p><code>NODE_NAME</code> is unset: nothing to show.</p>
</div>

<!-- service card template: every data-f is filled by app.js from /api/v1/status -->
<template id="service-card-tpl">
  <div>
    <section class="t-card service-card">
      <div class="t-card-header">
        <h2 class="t-card-title"><i class="t-icon bi bi-box" aria-hidden="true"></i><span data-f="name"></span> <a data-f="url" class="t-small" hidden target="_blank" rel="noopener" title="Open the service"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a></h2>
        <span class="t-badge" data-variant="tint" data-tone="neutral" data-f="mode-badge"><span class="t-dot" data-status="muted"></span> primary: <span data-f="mode"></span></span>
      </div>
      <div class="t-card-body">
        <div class="t-stat-sub mb-2" data-f="since"></div>
        <table class="t-table hosts-table service-hosts mb-2" data-density="compact">
          <thead><tr><th class="t-nowrap">host</th><th class="t-nowrap">role</th><th class="t-nowrap">service</th><th class="t-nowrap">class</th></tr></thead>
          <tbody data-f="hosts"></tbody>
        </table>
        <dl class="t-facts facts-grid">
          <dt>agreed</dt><dd data-f="agreed"></dd>
          <dt>lease</dt><dd data-f="lease"></dd>
          <dt>hold</dt><dd data-f="hold"></dd>
          <dt>last transition</dt><dd data-f="last-transition"></dd>
          <dt>routes</dt><dd data-f="routes"></dd>
          <dt>acting node</dt><dd data-f="acting"></dd>
        </dl>
        <div class="timer" data-f="timer-down">
          <div class="timer-row"><span class="t-stat-label" data-f="timer-down-label">primary down</span><span class="t-stat-value t-mono" data-f="timer-down-text">—</span></div>
          <div class="t-progress" data-size="sm" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><div class="t-progress-bar" data-f="timer-down-bar"></div></div>
        </div>
        <div class="timer" data-f="timer-stable">
          <div class="timer-row"><span class="t-stat-label" data-f="timer-stable-label">primary stable</span><span class="t-stat-value t-mono" data-f="timer-stable-text">—</span></div>
          <div class="t-progress" data-size="sm" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><div class="t-progress-bar" data-f="timer-stable-bar"></div></div>
        </div>
        <div class="t-stat-sub mt-2" data-f="cooldown"></div>
        <dl class="t-facts facts-grid mt-2" data-f="replica" hidden>
          <dt>replica</dt><dd data-f="replica-value"></dd>
        </dl>
      </div>
      <div class="t-card-footer service-actions">
        <label class="t-check" data-variant="switch">
          <input class="t-check-input" type="checkbox" role="switch" data-f="hold-switch">
          <span class="t-check-label t-stat-sub" data-f="hold-label">hold (block automatic failback)</span>
        </label>
        <div class="t-cluster mt-2" data-gap="2">
          <button class="t-btn" data-size="sm" data-variant="warning" data-action="promote"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> promote</button>
          <button class="t-btn" data-size="sm" data-tone="success" data-action="demote"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i> demote</button>
          <button class="t-btn" data-size="sm" data-variant="ghost" data-action="promote" data-dry="1">promote --dry-run</button>
          <button class="t-btn" data-size="sm" data-variant="ghost" data-action="demote" data-dry="1">demote --dry-run</button>
        </div>
        <div class="t-stat-sub mt-2" data-f="actions-note"></div>
      </div>
    </section>
  </div>
</template>

<!-- Tailor.confirm contract: #t-confirm with #t-confirm-title (text span), #t-confirm-body, #t-confirm-ok -->
<dialog class="t-dialog" id="t-confirm" data-variant="confirm" data-tone="danger" aria-labelledby="t-confirm-title">
  <div class="t-dialog-header"><h2 class="t-dialog-title" id="t-confirm-title"><span class="t-icon" aria-hidden="true">▲</span><span>Are you sure?</span></h2>
    <button type="button" class="t-dialog-close" data-dialog-close aria-label="Close">×</button></div>
  <div class="t-dialog-body" id="t-confirm-body"></div>
  <div class="t-dialog-footer">
    <button type="button" class="t-btn" data-dialog-close>Cancel</button>
    <button type="button" class="t-btn t-confirm-ok" data-variant="danger" id="t-confirm-ok">Confirm</button>
  </div>
</dialog>

<!-- dry-run output (app.js showOutput: #output-modal, #output-title, #output-text) -->
<dialog class="t-dialog" id="output-modal" data-size="lg" aria-labelledby="output-title">
  <div class="t-dialog-header"><h2 class="t-dialog-title" id="output-title">Output</h2>
    <button type="button" class="t-dialog-close" data-dialog-close aria-label="Close">×</button></div>
  <div class="t-dialog-body"><pre class="t-code-pre log-tail" id="output-text"></pre></div>
  <div class="t-dialog-footer"><button type="button" class="t-btn" data-size="sm" data-dialog-close>Close</button></div>
</dialog>
