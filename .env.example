# sentinel — every tunable, one line per key. Copy to .env (0600, never committed).
# Defaults live in lib/sentinel/config.rb (core) and lib/config.rb (dashboard); an empty value
# means "use the default". Values below ARE the defaults unless marked.

# ---------------------------------------------------------------- node / files
# This node's key under hosts: in cluster.yml. Required, differs per node.
NODE_NAME=
# Host/service table, identical on every node
CLUSTER_FILE=config/cluster.yml
# State files (<service>/mode, locks, markers, hold)
STATE_DIR=data/state
# Hook logs
LOG_DIR=data/logs
# SQLite audit trail (events, transitions, leases)
DB_PATH=data/sentinel.db
# Daily prune horizon for events and transitions
EVENTS_KEEP_DAYS=30
# The cluster port peers talk to (sentinel_url in cluster.yml)
SENTINEL_PORT=4197
# Image tag used by the compose files
SENTINEL_TAG=0.5.0

# ---------------------------------------------------------------- polling
# Loop cycle in seconds
POLL_INTERVAL_S=2
# Consecutive dead cycles (with quorum) before a fast promote
DEAD_CONFIRM_POLLS=5
# Consecutive degraded cycles before the service counts as down
DEGRADED_CONFIRM_POLLS=1

# ---------------------------------------------------------------- timers
# Service down this long -> promote
PROMOTE_AFTER_S=60
# Primary healthy and stable this long -> demote (fail back)
FAILBACK_AFTER_S=30
# No promote this soon after a demote
PROMOTE_COOLDOWN_S=120
# Retry delay after a failed promote
PROMOTE_RETRY_S=120
# Retry delay after a failed demote
FAILBACK_RETRY_S=300

# ---------------------------------------------------------------- flap control
# Mode flips within the window that count as flapping
FLAP_FLIPS=3
# The window, seconds
FLAP_WINDOW_S=3600
# Failback delay while flapping
FLAP_FAILBACK_AFTER_S=600

# ---------------------------------------------------------------- cadences
# health hook while promoted
HOST_HEALTH_INTERVAL_S=15
# replicate fence while promoted (also throttles repeated log lines)
FENCE_INTERVAL_S=60
# replicate stack while promoted / replicate warm while watching
STACK_CHECK_INTERVAL_S=30
# Retry delay for a degraded stack
STACK_RETRY_S=120
# Heartbeat event
HEARTBEAT_S=300

# ---------------------------------------------------------------- switches (on | off)
# Automatic promote, node-wide (per service: auto_promote in cluster.yml)
AUTO_PROMOTE=on
# Automatic failback
AUTO_FAILBACK=on

# ---------------------------------------------------------------- timeouts (seconds)
# TCP and ICMP probes
TCP_TIMEOUT_S=2
# Service health probes (per service: tunables.probe_timeout_s)
HTTP_TIMEOUT_S=5
# Gossip and lease requests
PEER_TIMEOUT_S=2
# A peer view older than this is not counted
PEER_STALE_S=10
# An action received on a non-acting node is forwarded to the acting node (dry-runs take seconds)
FORWARD_TIMEOUT_S=60
# Majority lease TTL
LEASE_TTL_S=30
# Lease renew interval while a hook runs
LEASE_RENEW_S=10
# SIGTERM a hook after this (SIGKILL 10 s later)
HOOK_TIMEOUT_S=900

# ---------------------------------------------------------------- notifications
# Notify after the service has been down this long
NOTIFY_DOWN_AFTER_S=60
# Discord webhook; empty = skipped
DISCORD_WEBHOOK_URL=
# Apprise endpoint; empty = skipped
APPRISE_URL=

# ---------------------------------------------------------------- routes
# Node-wide default for routes.mode: ha-routes | off (ha-routes is an external CLI, see README)
ROUTE_MODE=off
# ha-routes binary (mode ha-routes only)
HA_ROUTES_BIN=
# Env file of ha-routes, read for the tunnel id (mode ha-routes only)
ROUTES_ENV_FILE=
# Cloudflare tunnel connector count shown in /status (optional; empty = not reported)
HA_TUNNEL_ID=
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Timeout for the route command
ROUTE_TIMEOUT_S=60

# ---------------------------------------------------------------- dashboard
# "served by" label
HOST_NAME=node-a
# Page poll interval
REFRESH_S=10
# Footer link to another node's dashboard (optional)
OTHER_INSTANCE_NAME=
OTHER_INSTANCE_URL=
# Set by the image build; override only for local runs
APP_VERSION=
BUILD_TIME=
# Host-prefix 308 redirect (e.g. FROM=standby. TO=sentinel.); off when empty
LEGACY_REDIRECT_FROM=
LEGACY_REDIRECT_TO=

# ---------------------------------------------------------------- MCP / logging
# Bearer for POST /mcp; empty disables /mcp (404)
SENTINEL_MCP_TOKEN=
# debug | info | warn | error
LOG_LEVEL=info
# Path of this file as handed to hooks (default: the repo's .env)
SN_ENV=

# ---------------------------------------------------------------- probe credentials (example names)
# cluster.yml services.<svc>.probe.username_env / password_env name the variables holding a
# Basic credential for the health URL (a 401 still counts as up). Example names:
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# ================================================================ Hook variables
# Read ONLY by the shipped example hooks (hooks/opencode, hooks/beacon) via $SN_ENV. Your own hooks
# define their own. Values are neutral examples; the hooks' internal defaults are the author's.

# --- hooks/opencode: two hosts, ssh, litestream replicas, docker
# Primary / standby host addresses and ssh access
NODE_A_HOST=192.0.2.10
NODE_B_HOST=192.0.2.20
NODE_A_SSH_USER=
NODE_B_SSH_USER=
NODE_A_SSH_PORT=22
NODE_B_SSH_PORT=22
SSH_KEY=$HOME/.ssh/id_ed25519
SSH_CONNECT_TIMEOUT_S=5
SSH_TIMEOUT_S=60
SSH_PROBE_TIMEOUT_S=20
SCP_TIMEOUT_S=600
# Standby's root checkout (state/, replica/, reverse/, scratch/); must be mounted at the same path in the container
NODE_B_ROOT=
# The service's data and config dirs (mounted at the same path in the container)
OPENCODE_DATA_DIR=$HOME/.local/share/opencode
OPENCODE_CONFIG_DIR=$HOME/.config/opencode
SERVER_ENV=
NODE_A_OPENCODE_DATA=$HOME/.local/share/opencode
# Units, containers and URLs on each host
NODE_A_OPENCODE_UNIT=opencode.service
NODE_B_OPENCODE_UNIT=standby-service.service
NODE_A_WEBUI_CONTAINER=webui
NODE_B_WEBUI_CONTAINER=webui
NODE_A_WEBUI_URL=https://ui.node-a.example.com
NODE_B_WEBUI_URL=https://ui.node-b.example.com
NODE_B_OPENCODE_URL=http://192.0.2.20:4096
WEBUI_TLS_VERIFY=on
# Containers stopped on the primary when fencing; the primary's re-assert timer paused during transitions
NODE_A_FENCE_CONTAINERS=
NODE_A_GUARD_TIMER=
NODE_A_READY_STATES=running degraded
# Databases replicated (space separated) and the primary one
DBS=opencode memory
PRIMARY_DB=opencode
SESSION_TABLE=session_v2
# Litestream: image, replica/reverse dirs, reverse container/service, compose profile
LITESTREAM_IMAGE=litestream/litestream:0.5.17
REPLICA_DIR=
REVERSE_DIR=
REVERSE_CONTAINER=
REVERSE_SERVICE=litestream-reverse
COMPOSE_DIR=
COMPOSE_FILE_PATH=
COMPOSE_PROFILE=promoted
# Warm followers (one litestream follower per DB so promote renames instead of restoring)
WARM=on
WARM_DIR=
WARM_CONTAINER_PREFIX=
WARM_INTERVAL_S=30
WARM_CATCHUP_S=5
WARM_FOLLOW_INTERVAL=1s
WARM_INTEGRITY_CHECK=quick
WARM_LAG_MAX_S=120
WARM_LOG_EVERY_S=600
WARM_LOG_MAX_SIZE=5m
WARM_RESTART_BACKOFF_S=60
WARM_STOP_TIMEOUT_S=30
# Promote/demote behaviour
RESTORE_INTEGRITY_CHECK=full
PROMOTE_HEALTH_TIMEOUT_S=120
PAIR_HEALTH_TIMEOUT_S=
PAIR_POLL_S=1
PROMOTE_STACK_RETRIES=2
STOP_TIMEOUT_S=30
KEEP_PRE_PROMOTE=2
KEEP_PRE_DEMOTE=2
KEEP_DEMOTE_SCRATCH=2
# What the hooks do about routes: core (the sentinel moves them) | off
HOOK_ROUTE_MODE=core

# --- hooks/beacon: two containers (an API + an MQTT broker) with a SQLite db, optional DNS records
BEACON_NODE_A_BEACON=beacon
BEACON_NODE_A_MOSQUITTO=mosquitto
BEACON_NODE_B_BEACON=beacon
BEACON_NODE_B_MOSQUITTO=mosquitto
BEACON_NODE_A_LITESTREAM=
BEACON_NODE_A_BEACON_DIR=
BEACON_NODE_B_BEACON_DIR=
BEACON_NODE_B_MOSQUITTO_DIR=
BEACON_DB=beacon
BEACON_SCRATCH_DIR=
# Image with sqlite3 for db checks (default: the sentinel image itself)
BEACON_SQLITE_IMAGE=
# Public names and MQTT port the hooks check / move
BEACON_BEACON_NAME=api.example.com
BEACON_MQTT_NAME=mqtt.example.com
BEACON_MQTT_PORT=1884
BEACON_DNS_NAMES=
BEACON_DNS_RESOLVER=192.0.2.1
# off: move no public hostnames | on/off: rewrite DNS records on promote/demote
BEACON_ROUTE_MODE=off
BEACON_DNS=on
# Pi-hole v6 primary/replica targets (app passwords), CA for the https replica
PIHOLE_PRIMARY_URL=http://192.0.2.1/api
PIHOLE_PRIMARY_PASSWORD=
PIHOLE_REPLICA_URL=
PIHOLE_REPLICA_PASSWORD=
PIHOLE_CA_FILE=
PIHOLE_TLS_VERIFY=on
PIHOLE_TIMEOUT_S=10
