# standby-status — every tunable, mirrored key for key in the real .env (0600, never committed).
# Defaults live in lib/config.rb; an empty value means "use the default".

# silver | tiny — shown as "served by" and used for the n/a labels
HOST_NAME=silver
# the other instance of this page, linked in the footer
OTHER_INSTANCE_NAME=tiny
OTHER_INSTANCE_URL=https://standby.node-b.example.internal

# sentinel on tiny (GET /status)
SENTINEL_URL=http://192.0.2.50:4197/status

# probed services; opencode /api/info needs the Basic credential (401 still counts as up)
SILVER_OPENCODE_URL=http://192.0.2.20:4096
SILVER_OPENCHAMBER_URL=https://openchamber.node-a.example.internal
TINY_OPENCODE_URL=https://opencode-tiny.node-b.example.internal
TINY_OPENCHAMBER_URL=https://openchamber-tiny.node-b.example.internal
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# tiny instance only: $TINY_ROOT bind (ro) for state/mode, replica lag, promote/demote log tail
TINY_ROOT=

# probes
PROBE_TIMEOUT_S=3
# LAN certificates are the minica wildcard; set false unless the CA is in the image
PROBE_TLS_VERIFY=false
# page polling interval and server-side coalescing window for /api/status
REFRESH_S=10
STATUS_CACHE_S=2
LOG_TAIL_LINES=20

# public DNS: DoH resolver and the names to show; tunnel ids map a CNAME target to a host
DOH_URL=https://cloudflare-dns.com/dns-query
DNS_NAMES=openchamber.example.com,opencode.example.com
SILVER_TUNNEL_ID=
TINY_TUNNEL_ID=

LOG_LEVEL=info
