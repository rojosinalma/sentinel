# standby-status — every tunable, mirrored key for key in the real .env (0600, never committed).
# Defaults live in lib/config.rb; an empty value means "use the default".

# silver | tiny — shown as "served by" and used for the n/a labels
HOST_NAME=silver
# the other instance of this page, linked in the footer
OTHER_INSTANCE_NAME=tiny
OTHER_INSTANCE_URL=https://standby.node-b.example.internal

# sentinel on tiny (GET /status)
SENTINEL_URL=http://192.0.2.50:4197/status

# probed services; opencode /api/info needs the Basic credential (401 still counts as up).
# The sentinel core reads the two OPENCODE_SERVER_* names via config/cluster.yml services.opencode.probe.
SILVER_OPENCODE_URL=http://192.0.2.20:4096
SILVER_OPENCHAMBER_URL=https://openchamber.node-a.example.internal
# silver's user timer that re-asserts opencode from silver's (gossip-lagged) view of mode. The opencode
# hooks stop it with every fence and the demote starts it again once silver is primary and healthy;
# left running it restarted opencode mid-swap (2026-10-15 drill).
SILVER_GUARD_TIMER=opencode-guard.timer
TINY_OPENCODE_URL=https://opencode-tiny.node-b.example.internal
TINY_OPENCHAMBER_URL=https://openchamber-tiny.node-b.example.internal
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# tiny instance only: $TINY_ROOT bind (ro) for state/mode, replica lag, promote/demote log tail
TINY_ROOT=

# probes
PROBE_TIMEOUT_S=3
# LAN certificates are the minica wildcard; set false unless the CA is in the image
PROBE_TLS_VERIFY=false
# page polling interval and server-side coalescing window for /api/status
REFRESH_S=10
STATUS_CACHE_S=2
LOG_TAIL_LINES=20

# public DNS: DoH resolver and the names to show; tunnel ids map a CNAME target to a host
DOH_URL=https://cloudflare-dns.com/dns-query
DNS_NAMES=openchamber.example.com,opencode.example.com
SILVER_TUNNEL_ID=
TINY_TUNNEL_ID=

LOG_LEVEL=info

# ---------------------------------------------------------------- sentinel core
# Which cluster node this instance is (silver | tiny | witness-1). Required.
NODE_NAME=
# Host/service table, identical on every node
CLUSTER_FILE=config/cluster.yml

# loop timers (bash sentinel defaults)
POLL_INTERVAL_S=2
DEAD_CONFIRM_POLLS=5
PROMOTE_AFTER_S=60
FAILBACK_AFTER_S=30
PROMOTE_COOLDOWN_S=120
PROMOTE_RETRY_S=120
FAILBACK_RETRY_S=300
FLAP_FLIPS=3
FLAP_WINDOW_S=3600
FLAP_FAILBACK_AFTER_S=600
HOST_HEALTH_INTERVAL_S=15
FENCE_INTERVAL_S=60
STACK_CHECK_INTERVAL_S=30
STACK_RETRY_S=120
NOTIFY_DOWN_AFTER_S=60
HEARTBEAT_S=300
AUTO_PROMOTE=on
AUTO_FAILBACK=on

# probe/peer timeouts (seconds)
TCP_TIMEOUT_S=2
HTTP_TIMEOUT_S=5
PEER_TIMEOUT_S=2
# a promote/demote/hold request landing on a non-acting node is replayed against the acting node (dry-runs take seconds)
FORWARD_TIMEOUT_S=60
PEER_STALE_S=10

# majority lease
LEASE_TTL_S=30
LEASE_RENEW_S=10

# hooks
HOOK_TIMEOUT_S=900

# paths (STATE_DIR is $TINY_ROOT/state on tiny)
STATE_DIR=data/state
LOG_DIR=data/logs
DB_PATH=data/sentinel.db
EVENTS_KEEP_DAYS=30

# serving
SENTINEL_PORT=4197

# notifications (either empty = skipped)
DISCORD_WEBHOOK_URL=
APPRISE_URL=

# public hostname routing by the core: ha-routes | off. Retired 2026-10-15: every service is
# routes: {mode: off} in cluster.yml (Ingressi follows the running instance), so this is inert.
ROUTE_MODE=off
# what the opencode hooks do about routes: core (default) | off — both log only since 2026-10-15
HOOK_ROUTE_MODE=core
# ha-routes binary (retired, leave empty) + CF credentials (acting node only; the loop still reads
# the ha-tunnel connector count from the CF API with them; tunnel id read from routes.env when unset)
HA_ROUTES_BIN=
HA_TUNNEL_ID=
CF_API_TOKEN=
CF_ACCOUNT_ID=
ROUTE_TIMEOUT_S=60

# --- fleet (hooks/fleet: hangar + mosquitto standby on tiny; phase 5) --------------------
# Not wired into cluster.yml yet (hooks/fleet/README.md: the core has one mode file per node);
# the hooks read these when run by hand or by a later release. Containers on both hosts (the tiny pair
# carries the same names as silver's since 2026-10-15 — hangar@tiny / mosquitto@tiny in the deployer):
FLEET_SILVER_HANGAR=hangar
FLEET_SILVER_MOSQUITTO=mosquitto
FLEET_TINY_HANGAR=hangar
FLEET_TINY_MOSQUITTO=mosquitto
# silver's litestream sidecar that also streams hangar.db (opencode-tiny's); demote stops it while swapping the db
FLEET_SILVER_LITESTREAM=opencode-tiny-litestream
FLEET_SILVER_HANGAR_DIR=/home/user/dev/hangar
FLEET_TINY_HANGAR_DIR=/home/user/dev/hangar
# the public names the LAN resolves through the Pi-hole split-horizon; the hooks move their address= lines
FLEET_HANGAR_NAME=hangar.example.com
FLEET_MQTT_NAME=mqtt.example.com
FLEET_MQTT_PORT=1884
# off (default): the hook moves no public hostnames (Pi-hole records only; tunnel routes are the core's)
FLEET_ROUTE_MODE=off
# on (default) | off: rewrite the Pi-hole records on promote/demote
FLEET_DNS=on
# image with sqlite3 for hangar.db checks/backups (default: the sentinel image itself)
FLEET_SQLITE_IMAGE=
# Pi-hole v6 targets: app passwords (deployer settings pihole_primary_password / pihole_replica_password,
# = HOMEPAGE_VAR_PIHOLE_KEY / _TURING_KEY in homepage's .env). CA file verifies the https replica
# (minica); PIHOLE_TLS_VERIFY=off falls back to -k when the file is not mounted here.
PIHOLE_PRIMARY_URL=http://192.0.2.4/api
PIHOLE_PRIMARY_PASSWORD=
PIHOLE_REPLICA_URL=https://pihole.witness-1.example.internal/api
PIHOLE_REPLICA_PASSWORD=
PIHOLE_CA_FILE=/etc/ssl/minica.pem
PIHOLE_TLS_VERIFY=on
PIHOLE_TIMEOUT_S=10
