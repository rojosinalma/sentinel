# standby-status — every tunable, mirrored key for key in the real .env (0600, never committed).
# Defaults live in lib/config.rb; an empty value means "use the default".

# node-a | node-b — shown as "served by" and used for the n/a labels
HOST_NAME=node-a
# the other instance of this page, linked in the footer
OTHER_INSTANCE_NAME=node-b
OTHER_INSTANCE_URL=https://standby.node-b.example.com

# sentinel on node-b (GET /status)
SENTINEL_URL=http://192.0.2.50:4197/status

# probed services; opencode /api/info needs the Basic credential (401 still counts as up).
# The sentinel core reads the two OPENCODE_SERVER_* names via config/cluster.yml services.opencode.probe.
NODE_A_OPENCODE_URL=http://192.0.2.20:4096
NODE_A_WEBUI_URL=https://webui.node-a.example.com
NODE_B_OPENCODE_URL=https://opencode-node-b.node-b.example.com
NODE_B_WEBUI_URL=https://webui-node-b.node-b.example.com
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# node-b instance only: $NODE_B_ROOT bind (ro) for state/mode, replica lag, promote/demote log tail
NODE_B_ROOT=

# probes
PROBE_TIMEOUT_S=3
# LAN certificates are the minica wildcard; set false unless the CA is in the image
PROBE_TLS_VERIFY=false
# page polling interval and server-side coalescing window for /api/status
REFRESH_S=10
STATUS_CACHE_S=2
LOG_TAIL_LINES=20

# public DNS: DoH resolver and the names to show; tunnel ids map a CNAME target to a host
DOH_URL=https://cloudflare-dns.com/dns-query
DNS_NAMES=webui.example.com,opencode.example.com
NODE_A_TUNNEL_ID=
NODE_B_TUNNEL_ID=

LOG_LEVEL=info

# ---------------------------------------------------------------- sentinel core
# Which cluster node this instance is (node-a | node-b | witness-1). Required.
NODE_NAME=
# Host/service table, identical on every node
CLUSTER_FILE=config/cluster.yml

# loop timers (bash sentinel defaults)
POLL_INTERVAL_S=2
DEAD_CONFIRM_POLLS=5
PROMOTE_AFTER_S=60
FAILBACK_AFTER_S=30
PROMOTE_COOLDOWN_S=120
PROMOTE_RETRY_S=120
FAILBACK_RETRY_S=300
FLAP_FLIPS=3
FLAP_WINDOW_S=3600
FLAP_FAILBACK_AFTER_S=600
HOST_HEALTH_INTERVAL_S=15
FENCE_INTERVAL_S=60
STACK_CHECK_INTERVAL_S=30
STACK_RETRY_S=120
NOTIFY_DOWN_AFTER_S=60
HEARTBEAT_S=300
AUTO_PROMOTE=on
AUTO_FAILBACK=on

# probe/peer timeouts (seconds)
TCP_TIMEOUT_S=2
HTTP_TIMEOUT_S=5
PEER_TIMEOUT_S=2
PEER_STALE_S=10

# majority lease
LEASE_TTL_S=30
LEASE_RENEW_S=10

# hooks
HOOK_TIMEOUT_S=900

# paths (STATE_DIR is $NODE_B_ROOT/state on node-b)
STATE_DIR=data/state
LOG_DIR=data/logs
DB_PATH=data/sentinel.db
EVENTS_KEEP_DAYS=30

# serving
SENTINEL_PORT=4197

# notifications (either empty = skipped)
DISCORD_WEBHOOK_URL=
APPRISE_URL=

# public hostname routing by the core: ha-routes | off (per service: cluster.yml services.<svc>.routes)
ROUTE_MODE=ha-routes
# what the opencode hooks do about routes: core (default; the core switches) | ha-routes (manual runs) | off
HOOK_ROUTE_MODE=core
# ha-routes binary + CF credentials (acting node only; tunnel id read from routes.env when unset)
HA_ROUTES_BIN=
HA_TUNNEL_ID=
CF_API_TOKEN=
CF_ACCOUNT_ID=
ROUTE_TIMEOUT_S=60

# --- beacon (hooks/beacon: beacon + mosquitto standby on node-b; phase 5) --------------------
# Not wired into cluster.yml yet (hooks/beacon/README.md: the core has one mode file per node);
# the hooks read these when run by hand or by a later release. Containers on both hosts:
BEACON_NODE_A_BEACON=beacon
BEACON_NODE_A_MOSQUITTO=mosquitto
BEACON_NODE_B_BEACON=beacon-node-b
BEACON_NODE_B_MOSQUITTO=mosquitto-node-b
# node-a's litestream sidecar that also streams beacon.db (opencode-node-b's); demote stops it while swapping the db
BEACON_NODE_A_LITESTREAM=opencode-node-b-litestream
BEACON_NODE_A_BEACON_DIR=/home/user/dev/beacon
BEACON_NODE_B_BEACON_DIR=/home/user/dev/beacon-node-b
# the public names the LAN resolves through the Pi-hole split-horizon; the hooks move their address= lines
BEACON_BEACON_NAME=beacon.example.com
BEACON_MQTT_NAME=mqtt.example.com
BEACON_MQTT_PORT=1884
# off (default): the hook moves no public hostnames (Pi-hole records only; tunnel routes are the core's)
BEACON_ROUTE_MODE=off
# on (default) | off: rewrite the Pi-hole records on promote/demote
BEACON_DNS=on
# image with sqlite3 for beacon.db checks/backups (default: the sentinel image itself)
BEACON_SQLITE_IMAGE=
# Pi-hole v6 targets: app passwords (orchestrator settings pihole_primary_password / pihole_replica_password,
# = HOMEPAGE_VAR_PIHOLE_KEY / _WITNESS_KEY in homepage's .env). CA file verifies the https replica
# (minica); PIHOLE_TLS_VERIFY=off falls back to -k when the file is not mounted here.
PIHOLE_PRIMARY_URL=http://192.0.2.4/api
PIHOLE_PRIMARY_PASSWORD=
PIHOLE_REPLICA_URL=https://pihole.witness-1.example.com/api
PIHOLE_REPLICA_PASSWORD=
PIHOLE_CA_FILE=/etc/ssl/minica.pem
PIHOLE_TLS_VERIFY=on
PIHOLE_TIMEOUT_S=10
